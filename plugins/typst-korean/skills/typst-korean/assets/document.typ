// 폰트 설정 (대체 폰트 포함)
#set text(
  font: ("Pretendard", "Noto Sans KR", "Malgun Gothic"),
  lang: "ko",
  region: "KR",
  size: 11pt,
)

// 페이지 설정
#set page(
  paper: "a4",
  margin: (x: 2.5cm, y: 2.5cm),
)

// 문단 설정 (CJK 권장)
#set list(marker: [-])
#set par(
  leading: 1.5em,
  first-line-indent: 1em,
  justify: true,
)

